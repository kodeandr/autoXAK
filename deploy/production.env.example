# Domain without https:// or a trailing slash. DNS must point to this server.
APP_DOMAIN=autoxak.ru
ACME_EMAIL=
# Generated once by `bash deploy/production.sh init`; preserve on updates.
SECRET_KEY=
POSTGRES_PASSWORD=
# Optional integrations. Without a 2GIS key the API uses a neutral fallback.
DGIS_API_KEY=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# Preserve the existing value when migrating existing Yandex accounts.
YANDEX_ID_SALT=
# Change BOTH if this subnet overlaps another Docker/VPN network.
PROXY_SUBNET=172.29.250.0/24
PROXY_IP=172.29.250.2
PROXY_API_IP=172.29.250.3
PROXY_GATEWAY=172.29.250.1
PROXY_TRUSTED_IPS=172.29.250.1,172.29.250.2
# Use the EXACT existing volume name for migration; never guess it.
POSTGRES_VOLUME=autoxak-production_pgdata
POSTGRES_VOLUME_EXTERNAL=false
# Set to caddy only on a server without an existing HTTPS proxy on 80/443.
COMPOSE_PROFILES=
