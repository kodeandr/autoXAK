{
    email {$ACME_EMAIL}
    admin off
}

{$APP_DOMAIN} {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
    reverse_proxy api:8000 {
        transport http {
            dial_timeout 5s
            response_header_timeout 180s
        }
    }
}
