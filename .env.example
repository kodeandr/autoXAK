# Copy to .env and replace this value with a randomly generated secret.
# Generate with: openssl rand -hex 32
SECRET_KEY=
POSTGRES_PASSWORD=
# Set to false only in production with valid 2GIS API key
DGIS_USE_MOCK=true
DGIS_API_KEY=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=https://autoxak.ru/api/v1/auth/yandex/callback
ENABLE_YANDEX_DEMO=false
# Set this separately before rotating SECRET_KEY if Yandex IDs must stay stable.
YANDEX_ID_SALT=
# Optional: Access token expiry in seconds (default: 1 year for backward compatibility)
# ACCESS_TOKEN_EXPIRE_SECONDS=31536000
